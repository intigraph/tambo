# Canonical text pendant members use the Quipu semantic merge driver when configured.
**/pendant/export.nt merge=quipu
**/pendant/shapes.ttl merge=quipu
**/pendant/manifest.json merge=quipu
**/pendant/manifest.ttl merge=quipu
*.nt diff=quipu
# Preserve terminal recording bytes; CRLF is part of scriptreplay's byte counts.
docs/demos/monorepo-sync/output.log -text whitespace=cr-at-eol
