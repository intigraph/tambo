@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tambo: <https://w3id.org/intigraph/tambo/ns#> .
@prefix stack:    <https://w3id.org/intigraph/tambo/id/stack/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .

# ── Working the stack ───────────────────────────────────────────────────────
# The operational knowledge an agent needs on arrival: how each repo builds,
# tests, and proves itself, and the git discipline that binds them. Commands
# are entry points, not transcripts — each repo's own instruction file stays
# authoritative for detail.

stack:quipu
    tambo:buildCommand "just check" ;
    tambo:testCommand "just test" ;
    tambo:docsCommand "just docs build" ;
    tambo:installMethod "cargo install --locked --git https://github.com/scbrown/quipu --features shacl,onnx --bin quipu --bin quipu-server (no prebuilt release binaries; both bins named because quipu-server declares required-features and a plain build silently skips it)" ;
    tambo:verifyProof "quipu accepts an episode via knot and a control-gated SPARQL query finds it; the negative control corrupts a byte and must go red" ;
    tambo:gitDiscipline "trunk-based, straight to main; quality gates are the only gate; never force-push main" .

stack:camayoc
    tambo:buildCommand "just check" ;
    tambo:testCommand "just test" ;
    tambo:verifyProof "gate probes must be able to FAIL: a probe that cannot distinguish a refusal from an unreachable store is not a gate (scripts/gate_probe.sh)" ;
    tambo:gitDiscipline "trunk-based, straight to main; quality gates are the only gate; never force-push main" ;
    tambo:operationalNote "RML executor: scripts/rml_executor.py validate|execute — governed mappings fetched from quipu, deterministic N-Quads, commits through the SHACL-governed /knot lane" .

stack:bobbin
    tambo:buildCommand "just build" ;
    tambo:testCommand "just test" ;
    tambo:verifyProof "bobbin indexes a fixture and search returns it" ;
    tambo:gitDiscipline "trunk-based, straight to main" ;
    tambo:operationalNote "use bobbin's own interfaces before ad-hoc search: MCP tools first, bobbin CLI second, HTTP GET /search?q=... as fallback (not a JSON POST)" .

stack:yupana
    tambo:buildCommand "just build" ;
    tambo:testCommand "just test" ;
    tambo:docsCommand "just docs build" ;
    tambo:verifyProof "yupana answers impact on a fixture repo" ;
    tambo:gitDiscipline "trunk-based, straight to main" ;
    tambo:operationalNote "every served fact carries a tier; freshness is omitted rather than faked wherever unknown" .

stack:shantytown
    tambo:buildCommand "python -m pip install -e ." ;
    tambo:testCommand "python3 -m pytest -q" ;
    tambo:verifyProof "a check must be able to fail: anything reporting health must be demonstrated returning red" ;
    tambo:operationalNote "zero runtime dependencies is a design constraint, not an accident; version constant lives in BOTH pyproject.toml and shantytown/__init__.py" .

stack:creel
    tambo:buildCommand "just check" ;
    tambo:testCommand "just test" ;
    tambo:verifyProof "tests/browser.js drives real headless Chromium over CDP" ;
    tambo:gitDiscipline "trunk-based, straight to main; work is not finished until git push succeeds" ;
    tambo:operationalNote "no dependencies, no build step; app/ is the deployable artifact; harness scripts share one global scope and their load order is semantics" .

stack:tambo
    tambo:buildCommand "just check" ;
    tambo:installMethod "curl -fsSL https://raw.githubusercontent.com/intigraph/tambo/main/scripts/install.sh | sh (prebuilt release binary, sha256-verified)" ;
    tambo:verifyProof "three proofs, not one: installed (version read-back), working (functional round-trip with a paired negative control), observable (Prometheus actually scrapes)" ;
    tambo:operationalNote "tambo apply --plan reviewed.toml applies a reviewed plan; tambo verify re-proves an installed stack" .

# Cross-cutting: how knowledge itself moves through the stack.
stack:quipu tambo:knowledgeFlow
    "structured sources -> camayoc RML executor -> quipu governed named graphs -> bobbin retrieval / quipu packs. Packs (.qpack.db) are ordinary quipu SQLite stores with a manifest: quipu unpack <pack> attaches one; quipu pack --verify <pack> proves integrity." ;
    rdfs:seeAlso <https://github.com/scbrown/quipu/blob/main/docs/design/spanner-capabilities.md> .

# Former product identifiers
# Public entity names live under w3id.org/intigraph/tambo/id/stack/. Each
# links to its former caboodle.dev name so stores holding an older pack still
# resolve it. Current vocabulary and graph names use the Tambo namespace.
stack:bobbin owl:sameAs <https://caboodle.dev/stack/bobbin> .
stack:tambo owl:sameAs <https://caboodle.dev/stack/caboodle> .
stack:camayoc owl:sameAs <https://caboodle.dev/stack/camayoc> .
stack:creel owl:sameAs <https://caboodle.dev/stack/creel> .
stack:quipu owl:sameAs <https://caboodle.dev/stack/quipu> .
stack:shantytown owl:sameAs <https://caboodle.dev/stack/shantytown> .
stack:yupana owl:sameAs <https://caboodle.dev/stack/yupana> .

# Explicit former-name mappings; current facts use the Tambo vocabulary above.
tambo:buildCommand owl:equivalentProperty <https://caboodle.dev/ns#buildCommand> .
tambo:docsCommand owl:equivalentProperty <https://caboodle.dev/ns#docsCommand> .
tambo:gitDiscipline owl:equivalentProperty <https://caboodle.dev/ns#gitDiscipline> .
tambo:installMethod owl:equivalentProperty <https://caboodle.dev/ns#installMethod> .
tambo:knowledgeFlow owl:equivalentProperty <https://caboodle.dev/ns#knowledgeFlow> .
tambo:operationalNote owl:equivalentProperty <https://caboodle.dev/ns#operationalNote> .
tambo:testCommand owl:equivalentProperty <https://caboodle.dev/ns#testCommand> .
tambo:verifyProof owl:equivalentProperty <https://caboodle.dev/ns#verifyProof> .
stack:tambo owl:sameAs <https://w3id.org/intigraph/tambo/id/stack/caboodle> .
<https://w3id.org/intigraph/tambo/graph/stack-operations> owl:sameAs <https://caboodle.dev/graph/stack-operations> .
